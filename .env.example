# ── Claude (Anthropic) API ───────────────────────────────────────────────
# Get your API key at https://console.anthropic.com/
# The SDK reads this automatically; the app also picks it up explicitly.
ANTHROPIC_API_KEY=sk-ant-api-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# (Alternatively: CLAUDE_API_KEY=...)

# ── Claude model ────────────────────────────────────────────────────────
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-3-haiku-20240307
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.0

# ── Application ────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Data paths (relative to project root) ──────────────────────────────
DATA_DIR=data
SURVEYS_DIR=data/surveys
FRAMEWORKS_DIR=data/frameworks
AUDIT_LOG_DIR=outputs/logs

# ── Risk scoring thresholds (0-100 scale) ──────────────────────────────
# Bands: 0-20 very_low, 21-40 low, 41-60 moderate, 61-80 high, 81-100 critical
RISK_LOW_MAX=40
RISK_MODERATE_MAX=60
RISK_HIGH_MAX=80

# ── Low confidence threshold ─────────────────────────────────────────────
# Claude's self-assessed confidence below this value triggers manual review
LOW_CONFIDENCE_THRESHOLD=0.6
